{
  "manifest_version": 3,
  "name": "Privex",
  "version": "0.2.0",
  "description": "AI Privacy Shield",
  "permissions": ["storage", "tabs", "offscreen"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "backgroud.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detection.js", "privex_engine.js", "content.js"]
    }
  ]
}