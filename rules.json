{
  "version": 1,
  "updatedAt": "2026-10-23",
  "description": "Privex detection rules. Edit this file to change what the extension detects; installed extensions pick it up on their next sync (every 15 minutes, or Sync now on the Rules page).",
  "validators": [
    "phone",
    "ipv4",
    "ipv6",
    "aadhaar",
    "creditCard",
    "luhn",
    "upi",
    "iban",
    "domain"
  ],
  "priorities": [
    "WEAK",
    "MODEL",
    "PATTERN",
    "VALIDATED",
    "SECRET"
  ],
  "rules": [
    {
      "id": "pii-email-1",
      "category": "pii",
      "type": "EMAIL",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "flags": "g",
      "priority": "VALIDATED",
      "enabled": true
    },
    {
      "id": "pii-url-2",
      "category": "pii",
      "type": "URL",
      "pattern": "\\b(?:https?:\\/\\/|www\\.)[^\\s<>\"'`]+",
      "flags": "g",
      "priority": "PATTERN",
      "trim": true,
      "enabled": true
    },
    {
      "id": "pii-phone-3",
      "category": "pii",
      "type": "PHONE",
      "pattern": "(?<![\\w+])(?:(?:\\+|00)91[\\s-]?|0)?[6-9]\\d{4}[\\s-]?\\d{5}(?!\\d)",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "phone",
      "enabled": true
    },
    {
      "id": "pii-phone-4",
      "category": "pii",
      "type": "PHONE",
      "pattern": "(?<![\\w+])\\+\\d{1,3}[\\s.-]?(?:\\(\\d{1,4}\\)[\\s.-]?)?\\d{1,4}(?:[\\s.-]?\\d{2,4}){1,4}(?!\\d)",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "phone",
      "enabled": true
    },
    {
      "id": "pii-phone-5",
      "category": "pii",
      "type": "PHONE",
      "pattern": "(?<!\\w)(?:\\(\\d{3}\\)\\s?|\\d{3}[\\s.-])\\d{3}[\\s.-]\\d{4}(?!\\d)",
      "flags": "g",
      "priority": "PATTERN",
      "enabled": true
    },
    {
      "id": "pii-phone-6",
      "category": "pii",
      "type": "PHONE",
      "pattern": "(?<![\\d.])\\d{10}(?![\\d.])",
      "flags": "g",
      "priority": "WEAK",
      "validator": "phone",
      "enabled": true
    },
    {
      "id": "pii-ip-7",
      "category": "pii",
      "type": "IP",
      "pattern": "(?<![\\w.])(?:\\d{1,3}\\.){3}\\d{1,3}(?![\\d.]*\\d)",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "ipv4",
      "enabled": true
    },
    {
      "id": "pii-ip-8",
      "category": "pii",
      "type": "IP",
      "pattern": "(?<![\\w:])(?:[0-9A-Fa-f]{1,4}:){1,7}:?(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4})*)?(?![\\w:])",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "ipv6",
      "enabled": true
    },
    {
      "id": "pii-aadhaar-9",
      "category": "pii",
      "type": "AADHAAR",
      "pattern": "(?<!\\d)[2-9]\\d{3}[\\s-]?\\d{4}[\\s-]?\\d{4}(?!\\d)",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "aadhaar",
      "enabled": true
    },
    {
      "id": "pii-aadhaar-10",
      "category": "pii",
      "type": "AADHAAR",
      "pattern": "\\b(?:aadhaa?r|adhaa?r|uidai|uid)\\b(?:\\s*(?:card|no\\.?|number|num|#))*\\s*(?:is|:|-)?\\s*(\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4})(?![\\d]|[\\s-]\\d)",
      "flags": "gi",
      "priority": "VALIDATED",
      "group": 1,
      "enabled": true
    },
    {
      "id": "pii-aadhaar-11",
      "category": "pii",
      "type": "AADHAAR",
      "pattern": "(?<!\\d[\\s-]?)\\d{4}([\\s-])\\d{4}\\1\\d{4}(?![\\s-]?\\d)",
      "flags": "g",
      "priority": "PATTERN",
      "enabled": true
    },
    {
      "id": "pii-credit-card-12",
      "category": "pii",
      "type": "CREDIT_CARD",
      "pattern": "(?<!\\d)\\d(?:[ -]?\\d){12,18}(?!\\d)",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "creditCard",
      "enabled": true
    },
    {
      "id": "pii-gstin-13",
      "category": "pii",
      "type": "GSTIN",
      "pattern": "\\b\\d{2}[A-Z]{3}[ABCFGHLJPT][A-Z]\\d{4}[A-Z][1-9A-Z]Z[0-9A-Z]\\b",
      "flags": "g",
      "priority": "VALIDATED",
      "enabled": true
    },
    {
      "id": "pii-pan-14",
      "category": "pii",
      "type": "PAN",
      "pattern": "\\b[A-Z]{3}[ABCFGHLJPT][A-Z]\\d{4}[A-Z]\\b",
      "flags": "g",
      "priority": "VALIDATED",
      "enabled": true
    },
    {
      "id": "pii-ifsc-15",
      "category": "pii",
      "type": "IFSC",
      "pattern": "\\b[A-Z]{4}0[A-Z0-9]{6}\\b",
      "flags": "g",
      "priority": "PATTERN",
      "enabled": true
    },
    {
      "id": "pii-upi-id-16",
      "category": "pii",
      "type": "UPI_ID",
      "pattern": "\\b[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}\\b(?![.@\\w-])",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "upi",
      "enabled": true
    },
    {
      "id": "pii-iban-17",
      "category": "pii",
      "type": "IBAN",
      "pattern": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,4})?\\b",
      "flags": "g",
      "priority": "VALIDATED",
      "validator": "iban",
      "enabled": true
    },
    {
      "id": "pii-ssn-18",
      "category": "pii",
      "type": "SSN",
      "pattern": "\\b(?!000|666|9\\d\\d)\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b",
      "flags": "g",
      "priority": "PATTERN",
      "enabled": true
    },
    {
      "id": "pii-passport-19",
      "category": "pii",
      "type": "PASSPORT",
      "pattern": "\\b[A-PR-WY][1-9]\\d{6}\\b",
      "flags": "g",
      "priority": "MODEL",
      "enabled": true
    },
    {
      "id": "pii-date-of-birth-20",
      "category": "pii",
      "type": "DATE_OF_BIRTH",
      "pattern": "\\b(?:DOB|D\\.O\\.B\\.?|date of birth|birth ?date|born on)\\s*[:\\-]?\\s*(\\d{1,2}[\\/.\\-]\\d{1,2}[\\/.\\-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2}|\\d{1,2}(?:st|nd|rd|th)?\\s+[A-Za-z]{3,9},?\\s+\\d{4}|[A-Za-z]{3,9}\\s+\\d{1,2}(?:st|nd|rd|th)?,?\\s+\\d{4})",
      "flags": "gi",
      "priority": "VALIDATED",
      "group": 1,
      "enabled": true
    },
    {
      "id": "pii-mac-21",
      "category": "pii",
      "type": "MAC",
      "pattern": "\\b(?:[0-9A-Fa-f]{2}([:-]))(?:[0-9A-Fa-f]{2}\\1){4}[0-9A-Fa-f]{2}\\b",
      "flags": "g",
      "priority": "VALIDATED",
      "enabled": true
    },
    {
      "id": "pii-domain-22",
      "category": "pii",
      "type": "DOMAIN",
      "pattern": "\\b(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[a-z]{2,24}\\b",
      "flags": "g",
      "priority": "WEAK",
      "validator": "domain",
      "enabled": true
    },
    {
      "id": "secret-anthropic-api-key-1",
      "category": "secret",
      "type": "ANTHROPIC_API_KEY",
      "pattern": "\\bsk-ant-[A-Za-z0-9_-]{20,}",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-openai-api-key-2",
      "category": "secret",
      "type": "OPENAI_API_KEY",
      "pattern": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-stripe-key-3",
      "category": "secret",
      "type": "STRIPE_KEY",
      "pattern": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-github-token-4",
      "category": "secret",
      "type": "GITHUB_TOKEN",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{30,255}|github_pat_[A-Za-z0-9_]{50,})\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-google-api-key-5",
      "category": "secret",
      "type": "GOOGLE_API_KEY",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-google-oauth-6",
      "category": "secret",
      "type": "GOOGLE_OAUTH",
      "pattern": "\\bya29\\.[0-9A-Za-z_-]{20,}",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-aws-access-key-7",
      "category": "secret",
      "type": "AWS_ACCESS_KEY",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-aws-secret-key-8",
      "category": "secret",
      "type": "AWS_SECRET_KEY",
      "pattern": "aws_?secret_?access_?key[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9\\/+=]{40})",
      "flags": "gi",
      "priority": "SECRET",
      "group": 1,
      "enabled": true
    },
    {
      "id": "secret-slack-token-9",
      "category": "secret",
      "type": "SLACK_TOKEN",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-slack-webhook-10",
      "category": "secret",
      "type": "SLACK_WEBHOOK",
      "pattern": "https:\\/\\/hooks\\.slack\\.com\\/services\\/[A-Za-z0-9\\/]+",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-huggingface-token-11",
      "category": "secret",
      "type": "HUGGINGFACE_TOKEN",
      "pattern": "\\bhf_[A-Za-z0-9]{30,}\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-npm-token-12",
      "category": "secret",
      "type": "NPM_TOKEN",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-sendgrid-key-13",
      "category": "secret",
      "type": "SENDGRID_KEY",
      "pattern": "\\bSG\\.[\\w-]{22}\\.[\\w-]{43}\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-twilio-key-14",
      "category": "secret",
      "type": "TWILIO_KEY",
      "pattern": "\\bSK[0-9a-fA-F]{32}\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-jwt-15",
      "category": "secret",
      "type": "JWT",
      "pattern": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-bearer-token-16",
      "category": "secret",
      "type": "BEARER_TOKEN",
      "pattern": "\\bBearer\\s+([A-Za-z0-9._~+\\/=-]{8,})",
      "flags": "g",
      "priority": "SECRET",
      "group": 1,
      "enabled": true
    },
    {
      "id": "secret-supabase-key-17",
      "category": "secret",
      "type": "SUPABASE_KEY",
      "pattern": "\\bsbp_[A-Za-z0-9]{20,}\\b",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-database-url-18",
      "category": "secret",
      "type": "DATABASE_URL",
      "pattern": "\\b(?:mongodb(?:\\+srv)?|postgres(?:ql)?|mysql|mariadb|rediss?|amqps?|mssql|sqlserver):\\/\\/[^\\s\"'`<>]+",
      "flags": "g",
      "priority": "SECRET",
      "trim": true,
      "enabled": true
    },
    {
      "id": "secret-ssh-private-key-19",
      "category": "secret",
      "type": "SSH_PRIVATE_KEY",
      "pattern": "-----BEGIN[\\s\\S]*?PRIVATE KEY-----[\\s\\S]*?-----END[\\s\\S]*?PRIVATE KEY-----",
      "flags": "g",
      "priority": "SECRET",
      "enabled": true
    },
    {
      "id": "secret-password-20",
      "category": "secret",
      "type": "PASSWORD",
      "pattern": "\\b(?:password|passwd|pwd|passcode|pass ?phrase|pin|otp)(?:\\s+is\\s+|\\s*[:=]\\s*)[\"'`]?([^\\s\"'`]{4,})",
      "flags": "gi",
      "priority": "SECRET",
      "group": 1,
      "trim": true,
      "enabled": true
    },
    {
      "id": "secret-env-variable-21",
      "category": "secret",
      "type": "ENV_VARIABLE",
      "pattern": "\\b[A-Z][A-Z0-9_]*(?:KEY|SECRET|TOKEN|PASSWORD|PASSWD|PASS|PWD|AUTH|CREDENTIALS?|PRIVATE|DSN|SALT)[A-Z0-9_]*\\s*[:=]\\s*[\"']?([^\\s\"'`,;]{4,})",
      "flags": "g",
      "priority": "SECRET",
      "group": 1,
      "enabled": true
    },
    {
      "id": "secret-secret-22",
      "category": "secret",
      "type": "SECRET",
      "pattern": "\\b(?:api[_-]?key|apikey|secret(?:[_-]?key)?|access[_-]?token|auth[_-]?token|client[_-]?secret|private[_-]?key)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9_\\-.\\/+=]{12,})",
      "flags": "gi",
      "priority": "SECRET",
      "group": 1,
      "enabled": true
    }
  ]
}
